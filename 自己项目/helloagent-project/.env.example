# HelloAgents 模型配置
# OpenAI 兼容的模型接口
LLM_MODEL_ID=gpt-6-luna
LLM_API_KEY=your-local-codex2api-agent-key
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_TIMEOUT=120

# 商品发现搜索 API（第一版使用 Tavily 兼容接口）
TAVILY_API_KEY=your-tavily-api-key
PRODUCT_SEARCH_PROVIDER=tavily

# 平台浏览器使用本机 Edge + 独立 DrissionPage profile
DRISSION_PROFILE_DIR=C:\\Users\\小敏\\PycharmProjects\\SpiderAgent\\helloagent\\.drission-edge-profile
EDGE_PATH=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe
DRISSION_PORT=9232
DRISSION_HEADLESS=false
DRISSION_WAIT_MS=8000

# 应用配置
SHOPPING_USER_ID=default-user
SHOPPING_MEMORY_DB=/home/ubuntu/helloagent/data/shopping_memory.sqlite3
SHOPPING_RAG_DB=/home/ubuntu/helloagent/data/product_knowledge.sqlite3
SHOPPING_RAG_KNOWLEDGE_DIR=/home/ubuntu/helloagent/data/knowledge
# 语义记忆向量检索（启用前安装 hello-agents[qdrant]）
MEMORY_VECTOR_ENABLED=false
MEMORY_VECTOR_PATH=/home/ubuntu/helloagent/data/memory_vectors
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_EMBEDDING_MODEL=text-embedding-v3
MEMORY_EMBEDDING_DIMENSION=1024
MAX_PLATFORM_RESULTS=10
